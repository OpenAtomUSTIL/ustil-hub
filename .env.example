# 应用
PORT=3000
# 直连为 0；仅经单层受控反代且 API 不对外开放时设为 1
TRUST_PROXY_HOPS=0
# 逗号分隔多源（携带凭证）；生产示例：https://openatomustil.cn,https://docs.openatomustil.cn
CORS_ORIGIN=http://localhost:5173
# cookie 域（可选，v11.0）：如 .openatomustil.cn——主站会话对 docs 子域可见（文档站试调用）；本地留空
COOKIE_DOMAIN=

# 数据库
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ustil
REDIS_URL=redis://localhost:6379

# JWT（请替换为随机长密钥）
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# 个人信息信封加密主密钥（v10.0，32 字节 base64，替换为自己的随机值；不入库不进日志）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-32-bytes-base64-random-key

# 存储（local | r2）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# R2 bucket 必须关闭公开访问；头像及作业附件统一经过 API 读取。
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 兼容旧配置，现已停用公开链接，可留空。
R2_PUBLIC_BASE_URL=

# 上传（单位：字节，默认 10MB）
UPLOAD_MAX_SIZE=10485760

# 初始 ADMIN 种子（pnpm seed:admin，幂等；真实密码只留在本地 .env，MUST NOT 提交）
ADMIN_EMAIL=admin@ustil.com
ADMIN_PASSWORD=change-me

# —— 事务邮件（v12.0，腾讯云邮件推送 SES）——
# MAIL_DRIVER：api（SendEmail 模板发送）| smtp（SMTP 中继 + 本地模板）| none（不发信，开发默认）
MAIL_DRIVER=api
# 发件人地址（须在腾讯云 SES 完成发信域名验证）；可带别名：USTIL 开放论坛 <noreply@mail.openatomustil.cn>
MAIL_FROM=
# 邮件链接固定域名（腾讯模板审核规范：链接域名固定、变量只承载路径段）
MAIL_LINK_BASE=https://forum.openatomustil.cn
# 腾讯云 SES 控制台模板 ID（api 驱动必填；已过审模板）
MAIL_TPL_VERIFY_ID=236752          # 邮箱验证码
MAIL_TPL_RESET_ID=236751           # 重置密码
MAIL_TPL_NOTICE_REPLY_ID=236754    # 回复提醒
MAIL_TPL_NOTICE_ID=236755          # 通知提醒
# api 驱动：腾讯云 API 密钥（建议使用受限子账号密钥，只授 SES 发信权限；不入库不进日志）
MAIL_API_SECRET_ID=
MAIL_API_SECRET_KEY=
MAIL_API_REGION=ap-hongkong
# smtp 驱动：腾讯云 SES SMTP 接口（smtp.qcloudmail.com，端口 465/587；密码为 SMTP 专用密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
