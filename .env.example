# 应用
PORT=3000
CORS_ORIGIN=http://localhost:5173

# 数据库
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ustil
REDIS_URL=redis://localhost:6379

# JWT（请替换为随机长密钥）
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# 存储（local | r2）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# 上传（单位：字节，默认 10MB）
UPLOAD_MAX_SIZE=10485760

# 初始 ADMIN 种子（pnpm seed:admin，幂等；真实密码只留在本地 .env，MUST NOT 提交）
ADMIN_EMAIL=admin@ustil.com
ADMIN_PASSWORD=change-me
