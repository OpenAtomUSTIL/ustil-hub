# 构建上下文排除：防 .env 等敏感文件被 COPY 进镜像层，同时缩小上下文
.git
node_modules
dist
*.tsbuildinfo
coverage
.env
.env.*
*.log

# 本地数据目录（根锚定，勿写成 storage/ 以免误伤 src/modules/storage）
/storage
/postgres-data
/redis-data
/uploads

# 本地缓存、Agent 配置与浏览器凭据不进入构建上下文
.pnpm-store
.vite
.vite-temp
.cache
.claude
.codex
.agents
.cursor
.chatgpt
.dsh
.mimocode
.codebase-memory
.mcp*.json
.aider*
.envrc
.envrc.*
.netrc
*.pem
*.key
playwright-report
test-results
playwright/.auth
.auth

# 测试仅用于开发验证，不进入交付镜像
test
**/__tests__
**/*.spec.ts
**/*.test.ts
